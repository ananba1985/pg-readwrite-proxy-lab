# PostgreSQL / Pgpool-II 三机拓扑参数（不含密码）
# 复制为 config/cluster.env 后填写。正式交付通常由 install.sh 自动生成。

# 数据库节点：Kylin Linux Advanced Server V10 aarch64 + 已安装的 NebulaCM PostgreSQL 12.0。
# Pgpool 节点：Kylin Linux Advanced Server V10 (Halberd) aarch64。
PG_MAJOR=12
PG_VERSION_FULL=12.0
DB_DISTRIBUTION=NebulaCM
DBN_VERSION_MARKER=NebulaCM_Dbn_PostgreSQL-install-runtime-12.0-ky10-aarch64-20241212.tar.gz
DB_POSTGRES_SHA256=aecef1bcf6557271a4ffaf9b55eb53df81c883984e1489916c85e88677477bcf
DB_PG_BASEBACKUP_SHA256=c235544bad0e0dc61b9c4fbc6becc7181970b9179b2aa071ff8a1821899815bb
DB_PG_CONFIG_SHA256=90321c1cb01d583ffa55523fd54490f93b2cb17fbcbe5fd99319ef0812f224df
DB_TOOLS_SHA256=1cfa544a74dc88f1bdc88db52fac5566b73eec4a0c3b15e33e60ec86a2cffa0f
PG_OS_USER=postgres

PGPOOL_MAJOR=4.7
PGPOOL_VERSION=4.7.2
PGPOOL_INSTALL_PREFIX=/opt/pgpool-II-4.7.2
PG_CLIENT_PREFIX=/opt/pgpool-client-12.0
PGPOOL_RUNTIME_PREFIX=/opt/pgpool-runtime-kylin-v10
OFFLINE_PACKAGE_DIR=packages/payload
PGPOOL_PAYLOAD_FILE=pgpool-II-4.7.2-pg12.0-aarch64-kylin-v10.tar.gz
PGPOOL_PAYLOAD_SHA256=b80c79b8e6537a14a6adc8ab4ae58baa40a2e027c8fc99a3589510462425dbea
PG_CLIENT_PAYLOAD_FILE=postgresql-client-12.0-aarch64-kylin-v10.tar.gz
PG_CLIENT_PAYLOAD_SHA256=1314901d8b0de906fcc47c7784913fd347d07a3b563475f8eae4e16310ba8667
PGPOOL_RUNTIME_PAYLOAD_FILE=pgpool-runtime-kylin-v10-aarch64.tar.gz
PGPOOL_RUNTIME_PAYLOAD_SHA256=6d00411d0098b2bab0c3f9e3a0d5d009907189eb2b0e3a743edd3063bce9a257
SSHPASS_PAYLOAD_FILE=sshpass-1.10-aarch64-kylin-v10.tar.gz
SSHPASS_PAYLOAD_SHA256=84bcff17fc7e48d0a8552c985818e17e485f95a66b3c50c4eedde6bcbdc96ffd

# Pgpool 节点连接 Primary 与 Standby 共用的 root SSH 端口。
SSH_PORT=22

# 现有 Primary（数据库运行时不会由本项目安装或覆盖）
PRIMARY_HOST=192.168.80.110
PRIMARY_PORT=5432
PRIMARY_PGDATA=/pgsql/12/data
PRIMARY_PG_BIN_DIR=/opt/pgsql12/bin
PRIMARY_ADMIN_TOOL=/opt/pgsql12/bin/tools
PRIMARY_LISTEN_ADDRESSES=127.0.0.1,192.168.80.110

# 已预装同版 NebulaCM 12.0、允许重建数据目录的 Standby 目标机
STANDBY_HOST=192.168.80.120
STANDBY_PORT=5432
STANDBY_PGDATA=/pgsql/12/data
STANDBY_PG_BIN_DIR=/opt/pgsql12/bin
STANDBY_ADMIN_TOOL=/opt/pgsql12/bin/tools
STANDBY_LISTEN_ADDRESSES=127.0.0.1,192.168.80.120
STANDBY_APPLICATION_NAME=rw_standby
REPLICATION_SLOT_NAME=rw_standby_slot

# 独立 Pgpool-II
PGPOOL_HOST=192.168.80.140
PGPOOL_PORT=5432
PCP_PORT=9898
PGPOOL_SERVICE=pgpool
PGPOOL_CONFIG_DIR=/etc/pgpool-II

# pg_hba / pool_hba / firewalld 使用 CIDR，而不是主机名。
STANDBY_ADDRESS_CIDR=192.168.80.120/32
PGPOOL_ADDRESS_CIDR=192.168.80.140/32
# 多个客户端网段使用逗号分隔。禁止 0.0.0.0/0 或 ::/0。
ALLOWED_CLIENT_CIDRS=192.168.80.0/24
# 数据库节点当前不运行 firewalld；Pgpool 节点由安装器精确开放客户端 CIDR -> TCP/5432。
MANAGE_DB_FIREWALL=no
MANAGE_PGPOOL_FIREWALL=yes

# 专用账号。BUSINESS_USER/BUSINESS_DATABASE 必须已存在，脚本不会创建或改密。
REPLICATION_USER=rw_replicator
MONITOR_USER=pgpool_monitor
BUSINESS_USER=rw_lab_test
BUSINESS_DATABASE=rw_proxy_lab
PCP_USER=pgpool_admin

# Streaming Replication 参数（PostgreSQL 12 使用 WAL 段数量）
MAX_WAL_SENDERS=10
MAX_REPLICATION_SLOTS=10
WAL_KEEP_SEGMENTS=1000

# Pgpool-II 路由与健康检查
PRIMARY_READ_WEIGHT=0
STANDBY_READ_WEIGHT=1
DISABLE_LOAD_BALANCE_ON_WRITE=transaction
READ_LAG_THRESHOLD_SECONDS=5
SR_CHECK_PERIOD=5
HEALTH_CHECK_PERIOD=5
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_MAX_RETRIES=3
HEALTH_CHECK_RETRY_DELAY=1
CONNECT_TIMEOUT_MS=5000
NUM_INIT_CHILDREN=8
MAX_POOL=2
CONNECTION_LIFE_TIME=600
LOG_PER_NODE_STATEMENT=on

# 两个破坏性门禁必须默认 no；install.sh 只有在用户输入 APPLY 后才生成 yes。
APPLY_PRIMARY_RESTART=no
ALLOW_STANDBY_REINITIALIZE=no
