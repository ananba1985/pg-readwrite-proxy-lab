# PostgreSQL / Pgpool-II 三机拓扑参数（不含密码）
# 复制为 config/cluster.env 后填写。值中不要使用换行或单引号。

# 目标平台：优先适配 CentOS 7 aarch64；也保留 EL 8/9 x86_64 RPM 路径。
PG_MAJOR=16
PG_VERSION_FULL=16.4
PGPOOL_MAJOR=4.7
PGPOOL_VERSION=4.7.2
PGPOOL_INSTALL_MODE=auto
PGPOOL_INSTALL_PREFIX=/opt/pg-rw-proxy/pgpool-II-4.7.2
PGPOOL_SOURCE_URL=https://www.pgpool.net/source/pgpool-II-4.7.2.tar.gz
PGPOOL_SOURCE_SHA256=e72b9d0ff3620f7da7e33a58dda44b77919d056752dc9bd86b2985c4988d1938
# CentOS 7 ARM 上用于编译 Pgpool 的 libpq/psql 会从同版本 PostgreSQL 官方源码构建到此目录。
PG_CLIENT_PREFIX=/opt/pg-rw-proxy/postgresql-client-16.4

# Standby 软件安装：auto 会优先使用已预装的同版本 PostgreSQL；EL7/ARM 否则要求离线 RPM 包。
STANDBY_INSTALL_MODE=auto
POSTGRES_RPM_BUNDLE_DIR=packages/postgresql
PG_BLOCK_SIZE_KB=8
PG_WAL_BLOCK_SIZE_KB=8
PG_WAL_SEG_SIZE_MB=16
PG_OS_USER=postgres

# 现有主库
PRIMARY_HOST=10.20.0.11
PRIMARY_PORT=5432
PRIMARY_PGDATA=/var/lib/pgsql/16/data
PRIMARY_PG_BIN_DIR=/usr/pgsql-16/bin
PRIMARY_SERVICE=postgresql-16
PRIMARY_LISTEN_ADDRESSES=*

# 新从库
STANDBY_HOST=10.20.0.12
STANDBY_PORT=5432
STANDBY_PGDATA=/var/lib/pgsql/16/data
STANDBY_PG_BIN_DIR=/opt/pg-rw-proxy/postgresql-16.4/bin
STANDBY_SERVICE=postgresql-rw-16
STANDBY_LISTEN_ADDRESSES=*
STANDBY_APPLICATION_NAME=rw_standby
REPLICATION_SLOT_NAME=rw_standby_slot

# 独立 Pgpool-II
PGPOOL_HOST=10.20.0.13
PGPOOL_PORT=9999
PCP_PORT=9898
PGPOOL_SERVICE=pgpool
PGPOOL_CONFIG_DIR=/etc/pgpool-II

# pg_hba / firewalld 使用 CIDR，而不是主机名。
STANDBY_ADDRESS_CIDR=10.20.0.12/32
PGPOOL_ADDRESS_CIDR=10.20.0.13/32
# 多个客户端网段使用逗号分隔。严禁使用 0.0.0.0/0，除非有单独的网络安全评审。
ALLOWED_CLIENT_CIDRS=10.20.10.0/24
MANAGE_FIREWALL=yes

# 专用数据库账号。业务账号不会由本项目创建。
REPLICATION_USER=rw_replicator
MONITOR_USER=pgpool_monitor
LAB_USER=rw_lab_test
LAB_DATABASE=rw_proxy_lab
PCP_USER=pgpool_admin

# Streaming Replication 参数
MAX_WAL_SENDERS=10
MAX_REPLICATION_SLOTS=10
WAL_KEEP_SIZE=1024MB
# 限制复制槽最多保留的 WAL，防止 Standby 长期中断占满主库磁盘。
MAX_SLOT_WAL_KEEP_SIZE=10GB

# Pgpool-II 路由与健康检查
PRIMARY_READ_WEIGHT=0
STANDBY_READ_WEIGHT=1
DISABLE_LOAD_BALANCE_ON_WRITE=transaction
READ_LAG_THRESHOLD_SECONDS=5
SR_CHECK_PERIOD=5
HEALTH_CHECK_PERIOD=5
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_MAX_RETRIES=3
HEALTH_CHECK_RETRY_DELAY=1
CONNECT_TIMEOUT_MS=5000
NUM_INIT_CHILDREN=8
MAX_POOL=2
CONNECTION_LIFE_TIME=600
# 初次验证建议 on；稳定后根据日志量调整为 off。
LOG_PER_NODE_STATEMENT=on

# 现有 Primary 的重启是显式门禁。完成评审并进入维护窗口后才改为 yes。
APPLY_PRIMARY_RESTART=no
# Standby 数据目录非空时默认拒绝。确认旧目录可移动备份后才改为 yes。
ALLOW_STANDBY_REINITIALIZE=no
