# 敏感参数。复制为 config/secrets.env，填写后执行 chmod 600。
# 不要提交实际副本。物理隔离环境的一键入口支持直接密码参数；正常流程不回显，业务认证失败时会按现场调试约定把 BUSINESS_PASSWORD 明文写入 root-only 诊断日志。

REPLICATION_PASSWORD=CHANGE_ME_REPLICATION_PASSWORD
MONITOR_PASSWORD=CHANGE_ME_MONITOR_PASSWORD
# 现有 BUSINESS_USER 的密码；脚本只验证和写入 Pgpool pool_passwd，不修改数据库密码。
BUSINESS_PASSWORD=CHANGE_ME_EXISTING_BUSINESS_PASSWORD
PCP_PASSWORD=CHANGE_ME_PCP_PASSWORD
# Pgpool-II 用于 AES 加密 pool_passwd 的密钥，至少 32 个随机字符。
PGPOOL_AES_KEY=CHANGE_ME_LONG_RANDOM_AES_KEY
